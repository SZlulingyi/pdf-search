# Agent 编排运行模式
# true: 不需要后端和 Qwen，使用本地 mock 结果，方便验证 UI 和工具链
AGENT_MOCK=true
AGENT_MOCK_LLM=true

# 他的 FastAPI 后端
BACKEND_BASE_URL=http://127.0.0.1:8000

# Qwen3.5-7B / 其他 OpenAI 兼容服务
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL=qwen3.5-7b
QWEN_TIMEOUT_MS=120000
AGENT_MAX_STEPS=4
