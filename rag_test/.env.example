# RAGFlow's Python API
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_WEB_URL=http://127.0.0.1:8081

# Independent PaddleX / PP-StructureV3 service
PADDLEOCR_BASE_URL=http://127.0.0.1:8080
PADDLEOCR_ENDPOINT=http://127.0.0.1:8080/layout-parsing

# BGE-M3 through RAGFlow's TEI profile
TEI_HEALTH_URL=http://127.0.0.1:6380/health

# RAGFlow Elasticsearch, used by the exact-search sidecar
ES_URL=http://127.0.0.1:1200
ES_USER=elastic
ES_PASSWORD=infini_rag_flow

# Gateway port
PORT=8787

# 由 bootstrap 自动生成；通常无需修改
RAGFLOW_API_KEY_FILE=../data/ragflow-api-key

# 知索控制台登录账号；请首次启动后修改
CONSOLE_USER=admin
CONSOLE_PASSWORD=admin

# Optional OpenAI-compatible LLM
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-flash

# pdf-search FastAPI
PDFSEARCH_BASE_URL=http://127.0.0.1:8000
PDFSEARCH_API_KEY=
