# Gateway
PORT=8787

# PostgreSQL: 会话、消息、引用持久化
DATABASE_URL=postgres://zhisuo:zhisuo@127.0.0.1:5432/zhisuo

# 本地控制台登录
CONSOLE_USER=admin
CONSOLE_PASSWORD=admin

# 对方提供的 pdf-search FastAPI
PDFSEARCH_BASE_URL=http://127.0.0.1:8000
PDFSEARCH_API_KEY=

# 对方部署的 OpenAI-compatible LLM
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5-7b
LLM_TIMEOUT_MS=120000

# 单次上传上限（字节）
UPLOAD_MAX_BYTES=524288000
